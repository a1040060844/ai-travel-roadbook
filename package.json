{
  "name": "ai-travel-roadbook",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-roadbook.mjs",
    "test": "node --test tests/roadbook.test.mjs",
    "check": "npm run typecheck && npm run validate && npm run test",
    "build": "node scripts/prepare-manifest.mjs && vite build && node scripts/prepare-pwa.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "roadbook:use": "node scripts/use-roadbook.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "maplibre-gl": "5.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.2",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
