{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a1040060844/ai-travel-roadbook/schemas/roadbook.schema.json",
  "title": "AI Travel Roadbook content pack",
  "type": "object",
  "required": ["schemaVersion", "meta", "days", "guide"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "meta": {
      "type": "object",
      "required": ["slug", "title", "destination", "countryCode", "timezone", "theme"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "timezone": { "type": "string", "minLength": 1 },
        "theme": { "type": "object", "required": ["accent", "ink", "mist", "heroImage"] }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "label", "title", "scene", "image", "stops", "places", "segments"],
        "properties": {
          "id": { "type": "string", "pattern": "^day-[a-z0-9-]+$" },
          "date": { "type": "string", "format": "date" },
          "scene": { "enum": ["flight", "driving", "walking", "rail", "ferry", "sunset", "nature", "city", "static"] },
          "places": { "type": "array", "minItems": 1 },
          "segments": { "type": "array" }
        }
      }
    }
  }
}
